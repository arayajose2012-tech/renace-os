#!/bin/sh
# Ajustes finales de la imagen: permisos, servicios y el instalador sin red.
set -e

# ── Permisos de las herramientas de Renace ───────────────────
chmod 755 /usr/local/sbin/renace-* /usr/local/bin/renace-* \
          /usr/lib/systemd/system-sleep/renace-wifi

# ── Servicios ────────────────────────────────────────────────
systemctl enable renace-wifi.service

# Todo lo del modo servidor queda instalado pero apagado: no gasta RAM
# hasta que el usuario lo activa desde el Centro Renace.
for unidad in ssh.service ssh.socket smbd.service nmbd.service samba-ad-dc.service \
              docker.service docker.socket containerd.service cockpit.socket \
              renace-pantalla.service renace-autoencendido.service; do
    systemctl disable "$unidad" 2>/dev/null || true
done

# La tienda de aplicaciones no debe quedarse residente en memoria
rm -f /etc/xdg/autostart/org.gnome.Software.desktop \
      /etc/xdg/autostart/gnome-software-service.desktop

# ── Instalador (Calamares) sin conexión ──────────────────────
# Los ayudantes de Debian instalan GRUB con apt durante la instalación, lo que
# falla en un Mac que aún no tiene red. La imagen ya trae los binarios de GRUB
# (EFI de 64 y de 32 bits, y BIOS), así que se sustituyen por versiones locales.
echo "Renace: archivos de calamares-settings-debian:"
dpkg -L calamares-settings-debian | grep -iE 'bootloader|sources|helper' || true

for nombre in calamares-bootloader-config calamares-sources-media; do
    # Se localiza por el listado del paquete: la ruta cambia entre versiones
    ruta=$(dpkg -L calamares-settings-debian | grep "/$nombre\$" | head -n1)
    if [ -z "$ruta" ] || [ ! -f "$ruta" ]; then
        echo "ERROR Renace: no se encontró $nombre; el instalador fallaría sin red." >&2
        exit 1
    fi
    dpkg-divert --quiet --add --rename --divert "$ruta.debian" "$ruta"
    cp "/usr/share/renace/calamares/$nombre" "$ruta"
    chmod 755 "$ruta"
    echo "Renace: sustituido $ruta"
done

# ── Instalador: sin validación de contraseñas por diccionario ──
# Calamares comprueba la contraseña con libpwquality y falla si no encuentra el
# diccionario. Se elimina ese bloque de users.conf y se conservan el resto de
# ajustes (grupos, sudo, etc.).
USERS=/etc/calamares/modules/users.conf
if [ -f "$USERS" ]; then
    python3 - "$USERS" <<'PY'
import re, sys
ruta = sys.argv[1]
salida, saltando, sangria = [], False, 0
for linea in open(ruta, encoding="utf-8").read().splitlines():
    if saltando:
        if linea.strip() == "" or len(linea) - len(linea.lstrip()) > sangria:
            continue
        saltando = False
    if re.match(r"^\s*libpwquality\s*:", linea):
        saltando = True
        sangria = len(linea) - len(linea.lstrip())
        continue
    salida.append(linea)
open(ruta, "w", encoding="utf-8").write("\n".join(salida) + "\n")
PY
    if grep -q libpwquality "$USERS"; then
        echo "AVISO Renace: no se pudo quitar libpwquality de $USERS" >&2
    else
        echo "Renace: validación por diccionario eliminada de $USERS"
    fi
else
    echo "AVISO Renace: no existe $USERS" >&2
fi

# ── Identidad ────────────────────────────────────────────────
echo "Renace OS 1.0 (basado en Debian 13)" > /etc/renace-release
mkdir -p /etc/renace
[ -f /etc/renace/modo ] || echo escritorio > /etc/renace/modo
