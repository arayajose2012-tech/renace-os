<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Renace OS</vendor>

  <action id="org.renace.wifi">
    <description>Configurar el Wi-Fi del Mac</description>
    <message>Se necesita su contraseña para cambiar el controlador Wi-Fi</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/renace-wifi</annotate>
  </action>

  <action id="org.renace.modo">
    <description>Cambiar entre modo escritorio y modo servidor</description>
    <message>Se necesita su contraseña para cambiar el modo del equipo</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/renace-mode</annotate>
  </action>
</policyconfig>
